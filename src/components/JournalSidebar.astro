---
import { getPosts, getTags, postUrl, tagUrl } from '../lib/journal';

const posts = await getPosts();
const tags = getTags(posts);
---

<aside class="journal-aside">
  <h2>Recent entries</h2>
  <ol>
    {posts.slice(0, 7).map((post) => <li><a href={postUrl(post)}>{post.data.title}</a></li>)}
  </ol>
  <h2>Categories</h2>
  <ol>
    {tags.map((tag) => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
  </ol>
</aside>
