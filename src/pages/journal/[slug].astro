---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import JournalSidebar from '../../components/JournalSidebar.astro';
import { formatDate, getPosts, postUrl, splitPost, stripTags, tagUrl, type Post } from '../../lib/journal';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  // Posts are newest first, so the next item in the list is the previous post.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, previous: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, previous } = Astro.props as { post: Post; previous?: Post };
const { intro, body } = splitPost(post);
---

<Base title={post.data.title} description={stripTags(intro).slice(0, 200)}>
  <div class="journal">
    <article class="journal-main">
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.tags.length > 0 && (
          <span> · {post.data.tags.map((tag, i) => <>{i > 0 && ', '}<a href={tagUrl(tag)}>{tag}</a></>)}</span>
        )}
      </p>
      <div class="prose intro" set:html={intro} />
      <div class="prose" set:html={body} />
      {previous && (
        <nav class="pagination" aria-label="Older post">
          <a href={postUrl(previous)} class="prev">← {previous.data.title}</a>
        </nav>
      )}
    </article>
    <JournalSidebar />
  </div>
</Base>
